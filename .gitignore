# Dependencies installed locally during tests or toolkit development.
node_modules/

# `playground` creates a `dist/` dir.
dist/

# Runtime logs generated by devcontainer background services.
.logs/
*.log

# Environment variables and secrets (safety net; those should be configured as GitHub Secrets, not in an `.env` file).
.env
.env.*

# Operating system desktop and thumbnail metadata files.
.DS_Store
Thumbs.db
